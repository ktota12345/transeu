// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Agent {
  id                        Int       @id @default(autoincrement())
  name                      String
  description               String
  isActive                  Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  priority                  Int?
  operator                  String?
  tags                      String[]
  specializations           String[]
  priorityClients           String[]
  preferredCargoTypes       String[]
  unwantedCargoTypes        String[]
  cargoTypes                String[]
  additionalServices        String[]
  preferredRoutes           String[]
  regionsToAvoid            String[]
  vehicleBases              String[]
  selectedLogisticsBase     Int?
  selectedGermanDestinations String[]
  customLogisticsPoint      Json?
  maxOperatingRadius        Int?
  preferredCountries        String[]
  unwantedCountries         String[]
  roadPreferences           String[]
  timocomSettings           Json?
  minRatePerKm              Decimal?  @default(0.0)
  targetRatePerKm           Decimal?  @default(0.0)
  minOrderValue             Decimal?  @default(0.0)
  preferredPaymentTerms     String[]
  currencies                String[]
  additionalFees            Json?
  emptyKmCost               Decimal?  @default(0.0)
  minProfitMargin           Float?    @default(0.0)
  availabilityQueryParams   Json?
  minAvailabilityBuffer     Int?
  preferredDays             String[]
  preferredHours            Json?
  maxExecutionTime          Int?
  timeBuffer                Int?
  availabilityUpdateFrequency String?
  checkPriority             String?
  trailerTypes              String[]
  liftCapacityRange         Json?
  specialEquipment          String[]
  certificates              String[]
  cargoParameters           Json?
  specialRequirements       String?
  negotiationAggressiveness Int?      @default(0)
  maxCounterOffers          Int?
  minResponseTime           Int?
  maxResponseTime           Int?
  negotiationStrategiesSelected String[]
  negotiationInstructions   String?
  priceThreshold            Float?
  unusualClientRequirements String[]
  keywordTriggers           String[]
  emotionDetectionLevel     Int?
  negotiationStagesRequiringHuman String[]
  maxClientIdleTime         Int?
  checkFrequency            String?
  customCheckInterval       Int?
  workingHours              Json?
  workingDays               String[]
  scheduleExceptions        Json?
  workIntensity             String?
  maxConcurrentNegotiations Int?
  isDraft                   Boolean   @default(false)
  destinationCity           String?
  searchRadius              Int?
}




model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  username           String    @unique
  password           String
  role               Role      @default(USER)
  resetToken         String?   @db.VarChar(255)
  resetTokenExpiry   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  companyId          Int?
  company            Company?  @relation(fields: [companyId], references: [id])
  searchNotificationSetups SearchNotificationSetup[]
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}

model Carrier {
  id                 Int       @id @default(autoincrement())
  type               String
  name               String
  postalCode         String
  city               String
  address            String
  region             String
  licenseNumber      String
  licenseExpiryDate  DateTime?

  contacts           CarrierContact[]

  cars        Car[]      @relation("CarrierCars")
  drivers     Driver[]   @relation("CarrierDrivers")
}

model CarrierContact {
  id         Int     @id @default(autoincrement())
  carrierId  Int
  name       String?
  email      String?
  phone      String?
  source     String?
  details    Json?

  carrier    Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
}

model SearchScheduleSetup {
  id        Int      @id @default(autoincrement())
  name      String
  isDefault Boolean  @default(false)
  schedule  Json

  cars      Car[]    @relation("CarSearchSchedules")
}

model Car {
  id                  Int                  @id @default(autoincrement())
  name                String
  registrationNumber  String
  carType             String
  trailerType         String
  driverId            Int?
  driver              Driver?              @relation(fields: [driverId], references: [id])


  carrierId   Int?
  carrier     Carrier?  @relation("CarrierCars", fields: [carrierId], references: [id])

  schedules           CarSchedule[]
  offers              CarScheduleOffer[]

  searchSchedules     SearchScheduleSetup[] @relation("CarSearchSchedules")

  vehicleTypes         VehicleType[]         @relation("CarVehicleTypes")
  vehicleLoadSecurings VehicleLoadSecuring[] @relation("CarVehicleLoadSecurings")
  vehicleEquipments    VehicleEquipment[]    @relation("CarVehicleEquipments")
  swapBodies           SwapBody[]            @relation("CarSwapBodies")
  bodyProperties       BodyProperty[]        @relation("CarBodyProperties")
  searchNotificationSetup SearchNotificationSetup?
  bodies             VehicleBody[]         @relation("CarVehicleBodies")


  baseAddressId       Int?       @unique
  baseAddress         Address?   @relation(fields: [baseAddressId], references: [id])
}

model Address {
  id          Int     @id @default(autoincrement())
  country     String
  postalCode  String
  city        String
  latitude    Float
  longitude   Float
  car         Car?    @relation
  offerFrom   CarScheduleOffer[] @relation("OfferFromAddress")
  offerTo     CarScheduleOffer[] @relation("OfferToAddress")
}


model SearchNotificationSetup {
  id     Int  @id @default(autoincrement())

  carId  Int  @unique
  car    Car  @relation(fields: [carId], references: [id])

  users  User[]
  customEmails String[]
}


model Driver {
  id       Int     @id @default(autoincrement())
  name     String
  surname  String
  phone    String
  email    String
  cars     Car[]
  offers   CarScheduleOffer[]

  allowedCountries Country[] @relation("AllowedCountries")

  carrierId   Int?
  carrier     Carrier?  @relation("CarrierDrivers", fields: [carrierId], references: [id])
}

model CarSchedule {
  id        Int                @id @default(autoincrement())
  carId     Int
  car       Car                @relation(fields: [carId], references: [id], onDelete: Cascade)
  from      DateTime
  to        DateTime
  status    String             // np. 'available', 'unavailable', 'maintenance'
  offers    CarScheduleOffer[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model CarScheduleOffer {
  id              Int       @id @default(autoincrement())
  fromDate        DateTime
  toDate          DateTime
  fromAddressId   Int?
  fromAddress     Address?   @relation("OfferFromAddress", fields: [fromAddressId], references: [id])

  toAddressId     Int?
  toAddress       Address?   @relation("OfferToAddress", fields: [toAddressId], references: [id])

  externalId       String?   @unique
  externalLink     String?
  sourceSystem     String?

  status          String    // np. 'pending', 'confirmed', 'rejected'
  carId           Int?
  car             Car?       @relation(fields: [carId], references: [id])
  driverId        Int?
  driver          Driver?    @relation(fields: [driverId], references: [id])
  carScheduleId   Int?
  carSchedule     CarSchedule? @relation(fields: [carScheduleId], references: [id])
  details         Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model VehicleType {
  id             Int    @id @default(autoincrement())
  name           String
  apiNameTimocom String @unique

  cars           Car[]   @relation("CarVehicleTypes")
}
model VehicleLoadSecuring {
  id               Int    @id @default(autoincrement())
  name             String
  apiNameTimocom   String @unique

  cars           Car[]   @relation("CarVehicleLoadSecurings")
}
model VehicleEquipment {
  id             Int    @id @default(autoincrement())
  name           String
  apiNameTimocom String @unique

  cars           Car[]   @relation("CarVehicleEquipments")
}
model SwapBody {
  id             Int    @id @default(autoincrement())
  name           String
  apiNameTimocom String @unique

  cars           Car[]   @relation("CarSwapBodies")
}
model BodyProperty {
  id             Int    @id @default(autoincrement())
  name           String
  apiNameTimocom String @unique

  cars           Car[]   @relation("CarBodyProperties")
}

model City {
  id          Int     @id @default(autoincrement())
  name        String  // np. "Warszawa"
  postalCode  String  // np. "00-001"
  country     String  // np. "PL"
  latitude    Float   // np. 52.2297
  longitude   Float   // np. 21.0122
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  countryRel  Country @relation(fields: [country], references: [code], onDelete: Cascade)

  @@index([country, name])
  @@index([postalCode])
}

model Country {
    id         Int      @default(autoincrement())
  code        String   @id // np. "PL"
  name        String
  cities      City[]
  allowedByDrivers Driver[] @relation("AllowedCountries")

}

model VehicleBody {
  id             Int    @id @default(autoincrement())
  name           String
  apiNameTimocom String @unique

  cars           Car[]   @relation("CarVehicleBodies")
}

model ExchangeRate {
  id        Int      @id @default(autoincrement())
  currency  String   @unique
  rate      Float    // kurs względem EUR
  date      DateTime?
  createdAt DateTime @default(now())
}