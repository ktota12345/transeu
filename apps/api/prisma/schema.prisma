generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id                              Int      @id @default(autoincrement())
  name                            String
  description                     String
  isActive                        Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
  specializations                 String[]
  priorityClients                 String[]
  additionalServices              String[]
  destinationCity                 String?
  searchRadius                    Int?
  cargoParameters                 Json?
  checkFrequency                  String?
  liftCapacityRange               Json?
  negotiationInstructions         String?
  workingHours                    Json?
  additionalFees                  Json?
  availabilityQueryParams         Json?
  availabilityUpdateFrequency     String?
  certificates                    String[]
  checkPriority                   String?
  currencies                      String[]
  customCheckInterval             Int?
  customLogisticsPoint            Json?
  isDraft                         Boolean  @default(false)
  keywordTriggers                 String[]
  maxConcurrentNegotiations       Int?
  maxExecutionTime                Int?
  maxOperatingRadius              Int?
  minAvailabilityBuffer           Int?
  negotiationAggressiveness       Int?     @default(0)
  negotiationStagesRequiringHuman String[]
  negotiationStrategiesSelected   String[]
  operator                        String?
  preferredCargoTypes             String[]
  preferredCountries              String[]
  preferredDays                   String[]
  preferredHours                  Json?
  preferredPaymentTerms           String[]
  preferredRoutes                 String[]
  priority                        Int?
  regionsToAvoid                  String[]
  roadPreferences                 String[]
  scheduleExceptions              Json?
  selectedGermanDestinations      String[]
  selectedLogisticsBase           Int?
  specialEquipment                String[]
  specialRequirements             String?
  tags                            String[]
  timeBuffer                      Int?
  timocomSettings                 Json?
  trailerTypes                    String[]
  unusualClientRequirements       String[]
  unwantedCargoTypes              String[]
  unwantedCountries               String[]
  vehicleBases                    String[]
  workIntensity                   String?
  workingDays                     String[]
  emotionDetectionLevel           Int?
  emptyKmCost                     Decimal? @default(0.0)
  maxClientIdleTime               Int?
  maxCounterOffers                Int?
  maxResponseTime                 Int?
  minOrderValue                   Decimal? @default(0.0)
  minProfitMargin                 Float?   @default(0.0)
  minRatePerKm                    Decimal? @default(0.0)
  minResponseTime                 Int?
  priceThreshold                  Float?
  targetRatePerKm                 Decimal? @default(0.0)
  cargoTypes                      String[]
}

model User {
  id                       Int                       @id @default(autoincrement())
  email                    String                    @unique
  username                 String                    @unique
  password                 String
  role                     Role                      @default(USER)
  resetToken               String?                   @db.VarChar(255)
  resetTokenExpiry         DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  companyId                Int?
  company                  Company?                  @relation(fields: [companyId], references: [id])
  searchNotificationSetups SearchNotificationSetup[] @relation("SearchNotificationSetupToUser")
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Carrier {
  id                Int              @id @default(autoincrement())
  type              String
  name              String
  postalCode        String
  city              String
  address           String
  region            String
  licenseNumber     String
  licenseExpiryDate DateTime?
  cars              Car[]            @relation("CarrierCars")
  contacts          CarrierContact[]
  drivers           Driver[]         @relation("CarrierDrivers")
}

model CarrierContact {
  id        Int     @id @default(autoincrement())
  carrierId Int
  name      String?
  email     String?
  phone     String?
  source    String?
  details   Json?
  carrier   Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
}

model SearchScheduleSetup {
  id        Int     @id @default(autoincrement())
  name      String
  isDefault Boolean @default(false)
  schedule  Json
  cars      Car[]   @relation("CarSearchSchedules")
}

model Car {
  id                      Int                      @id @default(autoincrement())
  name                    String
  registrationNumber      String
  carType                 String?
  trailerType             String
  driverId                Int?
  carrierId               Int?
  baseAddressId           Int?                     @unique
  baseAddress             Address?                 @relation(fields: [baseAddressId], references: [id])
  carrier                 Carrier?                 @relation("CarrierCars", fields: [carrierId], references: [id])
  driver                  Driver?                  @relation(fields: [driverId], references: [id])
  schedules               CarSchedule[]
  offers                  CarScheduleOffer[]
  searchNotificationSetup SearchNotificationSetup?
  bodyProperties          BodyProperty[]           @relation("CarBodyProperties")
  searchSchedules         SearchScheduleSetup[]    @relation("CarSearchSchedules")
  swapBodies              SwapBody[]               @relation("CarSwapBodies")
  bodies                  VehicleBody[]            @relation("CarVehicleBodies")
  vehicleEquipments       VehicleEquipment[]       @relation("CarVehicleEquipments")
  vehicleLoadSecurings    VehicleLoadSecuring[]    @relation("CarVehicleLoadSecurings")
  vehicleTypes            VehicleType[]            @relation("CarVehicleTypes")
}

model Address {
  id         Int                @id @default(autoincrement())
  country    String
  postalCode String
  city       String
  latitude   Float
  longitude  Float
  car        Car?
  offerFrom  CarScheduleOffer[] @relation("OfferFromAddress")
  offerTo    CarScheduleOffer[] @relation("OfferToAddress")
}

model SearchNotificationSetup {
  id           Int      @id @default(autoincrement())
  carId        Int      @unique
  customEmails String[]
  car          Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  users        User[]   @relation("SearchNotificationSetupToUser")
}

model Driver {
  id               Int                @id @default(autoincrement())
  name             String
  surname          String
  phone            String
  email            String
  carrierId        Int?
  cars             Car[]
  offers           CarScheduleOffer[]
  carrier          Carrier?           @relation("CarrierDrivers", fields: [carrierId], references: [id])
  allowedCountries Country[]          @relation("AllowedCountries")
}

model CarSchedule {
  id        Int                @id @default(autoincrement())
  carId     Int
  from      DateTime
  to        DateTime
  status    String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  car       Car                @relation(fields: [carId], references: [id], onDelete: Cascade)
  offers    CarScheduleOffer[]
}

model CarScheduleOffer {
  id            Int          @id @default(autoincrement())
  fromDate      DateTime
  toDate        DateTime
  status        String
  carId         Int?
  driverId      Int?
  carScheduleId Int?
  details       Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  fromAddressId Int?
  toAddressId   Int?
  externalId    String?      @unique
  externalLink  String?
  sourceSystem  String?
  car           Car?         @relation(fields: [carId], references: [id])
  carSchedule   CarSchedule? @relation(fields: [carScheduleId], references: [id])
  driver        Driver?      @relation(fields: [driverId], references: [id])
  fromAddress   Address?     @relation("OfferFromAddress", fields: [fromAddressId], references: [id])
  toAddress     Address?     @relation("OfferToAddress", fields: [toAddressId], references: [id])
}

model VehicleType {
  id             Int      @id @default(autoincrement())
  name           String
  apiNameTimocom String   @unique
  transEuMapping String[] @default([])
  cars           Car[]    @relation("CarVehicleTypes")
}

model VehicleLoadSecuring {
  id             Int      @id @default(autoincrement())
  name           String
  apiNameTimocom String   @unique
  transEuMapping String[] @default([])
  cars           Car[]    @relation("CarVehicleLoadSecurings")
}

model VehicleEquipment {
  id             Int      @id @default(autoincrement())
  name           String
  apiNameTimocom String   @unique
  transEuMapping String[] @default([])
  cars           Car[]    @relation("CarVehicleEquipments")
}

model SwapBody {
  id             Int      @id @default(autoincrement())
  name           String
  apiNameTimocom String   @unique
  transEuMapping String[] @default([])
  cars           Car[]    @relation("CarSwapBodies")
}

model BodyProperty {
  id             Int      @id @default(autoincrement())
  name           String
  apiNameTimocom String   @unique
  transEuMapping String[] @default([])
  cars           Car[]    @relation("CarBodyProperties")
}

model City {
  id         Int      @id @default(autoincrement())
  name       String
  postalCode String
  country    String
  latitude   Float
  longitude  Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  countryRel Country  @relation(fields: [country], references: [code], onDelete: Cascade)

  @@index([country, name])
  @@index([postalCode])
}

model Country {
  code             String   @id
  name             String
  id               Int      @default(autoincrement())
  cities           City[]
  allowedByDrivers Driver[] @relation("AllowedCountries")
}

model VehicleBody {
  id             Int      @id @default(autoincrement())
  name           String
  apiNameTimocom String   @unique
  transEuMapping String[] @default([])
  cars           Car[]    @relation("CarVehicleBodies")
}

model ExchangeRate {
  id        Int       @id @default(autoincrement())
  currency  String    @unique
  rate      Float
  date      DateTime?
  createdAt DateTime  @default(now())
}

model TransEuToken {
  id           Int      @id @default(autoincrement())
  accessToken  String
  refreshToken String?
  expiresAt    DateTime
  tokenType    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TransEuAppToken {
  id          Int      @id @default(autoincrement())
  accessToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}
model TollCostCache {
  id            String   @id @default(uuid())
  startLat      Float
  startLng      Float
  endLat        Float
  endLng        Float
  costValue     Float?
  allInfo       Json?
  excludeCountries String[]
  distance      Float?
  duration      Int?
  baseDuration Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startLat, startLng, endLat, endLng])
}

model Contractor {
  id              Int               @id @default(autoincrement())
  legalName       String
  taxId           String?           // NIP itp.
  address         String?
  postalCode      String?
  city            String?
  country         String?

  aliases         ContractorAlias[]
  ratings         Rating[]          // Oceny od innych firm

  blacklisted     Boolean           @default(false)
  blacklistReason String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model ContractorAlias {
  id            Int        @id @default(autoincrement())
  name          String
  contractor    Contractor @relation(fields: [contractorId], references: [id])
  contractorId  Int
}

model Rating {
  id              Int        @id @default(autoincrement())
  contractor      Contractor @relation(fields: [contractorId], references: [id])
  contractorId    Int

  ratedByCompany  String     // Nazwa firmy oceniającej (można rozszerzyć na relację)
  ratingAverage   Float      // Np. 4.9
  communication   Int        // np. 1–5
  loadAsDescribed Int
  waitingForLoading   Int
  waitingForUnloading Int
  paymentIssue    Boolean    // Czy był problem z płatnością

  comment         String?    // Opcjonalna uwaga do oceny
  createdAt       DateTime   @default(now())
}
