// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Agent {
  id                        Int       @id @default(autoincrement())
  name                      String
  description               String
  isActive                  Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  priority                  Int?
  operator                  String?
  tags                      String[]
  specializations           String[]
  priorityClients           String[]
  preferredCargoTypes       String[]
  unwantedCargoTypes        String[]
  cargoTypes                String[]
  additionalServices        String[]
  preferredRoutes           String[]
  regionsToAvoid            String[]
  vehicleBases              String[]
  selectedLogisticsBase     Int?
  selectedGermanDestinations String[]
  customLogisticsPoint      Json?
  maxOperatingRadius        Int?
  preferredCountries        String[]
  unwantedCountries         String[]
  roadPreferences           String[]
  timocomSettings           Json?
  minRatePerKm              Decimal?  @default(0.0)
  targetRatePerKm           Decimal?  @default(0.0)
  minOrderValue             Decimal?  @default(0.0)
  preferredPaymentTerms     String[]
  currencies                String[]
  additionalFees            Json?
  emptyKmCost               Decimal?  @default(0.0)
  minProfitMargin           Float?    @default(0.0)
  availabilityQueryParams   Json?
  minAvailabilityBuffer     Int?
  preferredDays             String[]
  preferredHours            Json?
  maxExecutionTime          Int?
  timeBuffer                Int?
  availabilityUpdateFrequency String?
  checkPriority             String?
  trailerTypes              String[]
  liftCapacityRange         Json?
  specialEquipment          String[]
  certificates              String[]
  cargoParameters           Json?
  specialRequirements       String?
  negotiationAggressiveness Int?      @default(0)
  maxCounterOffers          Int?
  minResponseTime           Int?
  maxResponseTime           Int?
  negotiationStrategiesSelected String[]
  negotiationInstructions   String?
  priceThreshold            Float?
  unusualClientRequirements String[]
  keywordTriggers           String[]
  emotionDetectionLevel     Int?
  negotiationStagesRequiringHuman String[]
  maxClientIdleTime         Int?
  checkFrequency            String?
  customCheckInterval       Int?
  workingHours              Json?
  workingDays               String[]
  scheduleExceptions        Json?
  workIntensity             String?
  maxConcurrentNegotiations Int?
  isDraft                   Boolean   @default(false)
  destinationCity           String?
  searchRadius              Int?
}

model LogisticsBase {
  id                Int     @id @default(autoincrement())
  name              String
  addressFull       String
  addressCity       String
  addressPostalCode String
  addressCountry    String
  coordinatesLat    Float
  coordinatesLng    Float
}

model LocationDetails {
  id             Int     @id @default(autoincrement())
  date           DateTime
  timeWindow     String
  address        String
  city           String
  country        String
  postalCode     String
  contactPerson  String
  contactPhone   String
  contactEmail   String
  additionalInfo String
  location       String

}

model Cargo {
  id                    Int     @id @default(autoincrement())
  type                  String
  weight                Float
  weightUnit            String
  volume                Float
  volumeUnit            String
  loadingMeters         Float
  packages              Int
  packageType           String
  description           String
  adr                   Boolean
  temperature           Float?
  stackable            Boolean
  fragile               Boolean
  additionalRequirements String

}

model Vehicle {
  id                   Int     @id @default(autoincrement())
  type                 String
  requirements         String[]
  capacity             String
  size                 String
  additionalEquipment  String

}

model Financials {
  id               Int      @id @default(autoincrement())
  value            Float
  currency         String
  ratePerKm        Float
  estimatedDistance Float
  distance         Float
  fuelCost         Float
  driverCost       Float
  estimatedCosts   Float
  estimatedProfit  Float
  margin           Int
  valuePerKm       Float
  paymentTerm      String

}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  username           String    @unique
  password           String
  role               Role      @default(USER)
  resetToken         String?   @db.VarChar(255)
  resetTokenExpiry   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  companyId          Int?
  company            Company?  @relation(fields: [companyId], references: [id])
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}

model Carrier {
  id                 Int       @id @default(autoincrement())
  type               String
  name               String
  postalCode         String
  city               String
  address            String
  region             String
  licenseNumber      String
  licenseExpiryDate  DateTime?

  contacts           CarrierContact[]
}

model CarrierContact {
  id         Int     @id @default(autoincrement())
  carrierId  Int
  name       String?
  email      String?
  phone      String?
  source     String?

  carrier    Carrier @relation(fields: [carrierId], references: [id])
}

model Car {
  id               Int      @id @default(autoincrement())
  name             String
  registrationNumber String
  carType          String
  trailerType      String
}
